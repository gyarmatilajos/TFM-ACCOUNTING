<Window x:Class="TFM_ACCOUNTING.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:TFM_ACCOUNTING.Desktop.Views"
        Title="TFM Accounting" Height="900" Width="1440" MinHeight="720" MinWidth="1200"
        Background="#F4F6FA" FontFamily="Segoe UI" FontSize="14">
    <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="190" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
        <Border Background="#102A49" Padding="20,28">
            <StackPanel>
                <TextBlock Text="TFM" FontSize="34" Foreground="White" FontWeight="Bold" />
                <TextBlock Text="ACCOUNTING" Foreground="#A9C7E5" Margin="0,0,0,34" />
                <Button x:Name="ObligationsButton" Content="Tételek" Click="ShowObligations" Padding="12" Margin="0,0,0,12" />
                <Button x:Name="CompaniesButton" Content="Saját cégek" Click="ShowCompanies" Padding="12" Margin="0,0,0,12" Background="#007F87" Foreground="White" />
                <Button x:Name="PartnersButton" Content="Partnerek" Click="ShowPartners" Padding="12" Margin="0,0,0,12" Background="#E8EEF6" />
                <Button x:Name="SettingsButton" Content="Beállítások" Click="ShowSettings" Padding="12" Background="#E8EEF6" />
            </StackPanel>
        </Border>
        <DockPanel Grid.Column="1">
            <Border DockPanel.Dock="Bottom" Background="#E8EEF6" Padding="18,8">
                <TextBlock x:Name="DatabaseLabel" Foreground="#64748B" FontSize="12" />
            </Border>
            <Grid>
                <views:ObligationsView x:Name="ObligationsView" />
                <views:OwnCompaniesView x:Name="CompaniesView" Visibility="Collapsed" />
                <views:PartnersView x:Name="PartnersView" Visibility="Collapsed" />
                <views:SettingsView x:Name="SettingsView" Visibility="Collapsed" />
            </Grid>
        </DockPanel>
    </Grid>
</Window>
