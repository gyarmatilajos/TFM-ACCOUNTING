<Window x:Class="TFM_ACCOUNTING.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:TFM_ACCOUNTING.Desktop.Views"
        Title="TFM Accounting" Height="900" Width="1440" MinHeight="720" MinWidth="1200"
        Background="{StaticResource Workspace}" Foreground="{StaticResource Ink}" FontFamily="Segoe UI" FontSize="14">
    <Grid Background="{StaticResource Workspace}">
        <Grid.ColumnDefinitions><ColumnDefinition Width="204" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
        <Border Padding="8,24,8,18">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#102A49" Offset="0"/>
                    <GradientStop Color="#0B213C" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <DockPanel>
                <StackPanel DockPanel.Dock="Bottom" Margin="10,0">
                    <Border BorderBrush="#496079" BorderThickness="0,1,0,0" Margin="0,0,0,8"/>
                    <Button x:Name="SettingsButton" Style="{StaticResource NavigationButton}" Click="ShowSettings">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE713;" Style="{StaticResource Icon}" Margin="0,0,12,0"/><TextBlock Text="Beállítások"/></StackPanel>
                    </Button>
                </StackPanel>
                <StackPanel DockPanel.Dock="Top" Margin="18,0,0,28">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="TFM" FontSize="34" Foreground="White" FontWeight="Bold"/>
                        <Border Width="8" Height="28" Margin="11,0,0,0" Background="{StaticResource TealLight}" RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform><SkewTransform AngleX="-20"/></Border.RenderTransform>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="ACCOUNTING" FontSize="15" FontWeight="SemiBold" Foreground="#F5F8FC"/>
                </StackPanel>
                <StackPanel>
                    <Button x:Name="ObligationsButton" Style="{StaticResource NavigationButton}" Click="ShowObligations">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE7C3;" Style="{StaticResource Icon}" Margin="0,0,13,0"/><TextBlock Text="Tételek"/></StackPanel>
                    </Button>
                    <Button x:Name="CompaniesButton" Style="{StaticResource NavigationButton}" Click="ShowCompanies">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xEC06;" Style="{StaticResource Icon}" Margin="0,0,13,0"/><TextBlock Text="Saját cégek"/></StackPanel>
                    </Button>
                    <Button x:Name="PartnersButton" Style="{StaticResource NavigationButton}" Click="ShowPartners">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE716;" Style="{StaticResource Icon}" Margin="0,0,13,0"/><TextBlock Text="Partnerek"/></StackPanel>
                    </Button>
                    <Button x:Name="CategoriesButton" Style="{StaticResource NavigationButton}" Click="ShowCategories">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8EC;" Style="{StaticResource Icon}" Margin="0,0,13,0"/><TextBlock Text="Kategóriák"/></StackPanel>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>
        <DockPanel Grid.Column="1">
            <Border DockPanel.Dock="Bottom" Background="#E8EEF6" Padding="18,8">
                <TextBlock x:Name="DatabaseLabel" Foreground="#64748B" FontSize="12" />
            </Border>
            <Grid>
                <views:ObligationsView x:Name="ObligationsView" />
                <views:OwnCompaniesView x:Name="CompaniesView" Visibility="Collapsed" />
                <views:PartnersView x:Name="PartnersView" Visibility="Collapsed" />
                <views:SettingsView x:Name="SettingsView" Visibility="Collapsed" />
            </Grid>
        </DockPanel>
    </Grid>
</Window>
