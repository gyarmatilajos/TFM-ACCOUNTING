<Window xmlns:ui="clr-namespace:TFM_ACCOUNTING.Desktop.Views" x:Class="TFM_ACCOUNTING.Desktop.Views.PartnerNameMatchDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Azonos nevű partner" Width="760" Height="440" MinWidth="680" MinHeight="380"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="{StaticResource Workspace}" Foreground="{StaticResource Ink}" FontFamily="Segoe UI" FontSize="14">
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,16">
            <TextBlock Text="Már létezik ilyen nevű partner" FontSize="22" FontWeight="SemiBold" Foreground="#102A49" />
            <TextBlock Text="Ellenőrizd az azonosítókat. Másik személy vagy szervezet esetén menthetsz új partnert."
                       TextWrapping="Wrap" Margin="0,10,0,0" />
            <TextBlock Text="Legfeljebb az első 10 névegyezés látható." Foreground="#64748B" FontSize="12" Margin="0,6,0,0" />
        </StackPanel>
        <DataGrid Grid.Row="1" x:Name="MatchesGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                  SelectionMode="Single" SelectionUnit="FullRow" HeadersVisibility="Column">
            <DataGrid.Columns>
                <DataGridTextColumn ElementStyle="{StaticResource TableText}" Header="Partner neve" Binding="{Binding Name}" Width="*" MinWidth="220" />
                <DataGridTextColumn ElementStyle="{StaticResource TableText}" Header="Adószám / azonosító" Binding="{Binding Identifier}" Width="220" />
            </DataGrid.Columns>
        </DataGrid>
        <StackPanel Grid.Row="2" Margin="0,18,0,0">
            <TextBlock Text="Meglévő partner megnyitásakor az aktuális űrlap nem mentett adatait elvetjük."
                       Foreground="#64748B" TextWrapping="Wrap" Margin="0,0,0,12" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Meglévő megnyitása" ui:AccountingUi.Glyph="&#xE8E5;" Click="OpenExisting" Padding="12,8" Margin="0,0,8,0" />
                <Button Content="Mentés külön partnerként" ui:AccountingUi.Glyph="&#xE74E;" Click="SaveAnyway" Padding="12,8" Margin="0,0,8,0" Style="{StaticResource PrimaryButton}" />
                <Button Content="Mégse" ui:AccountingUi.Glyph="&#xE8BB;" IsCancel="True" Padding="12,8" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
