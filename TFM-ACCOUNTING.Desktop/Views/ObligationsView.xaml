<UserControl xmlns:ui="clr-namespace:TFM_ACCOUNTING.Desktop.Views" x:Class="TFM_ACCOUNTING.Desktop.Views.ObligationsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI" FontSize="14" Foreground="{StaticResource Ink}">
    <UserControl.Resources>
        <Style TargetType="Button" BasedOn="{StaticResource RoundedButton}">
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
        <Style TargetType="TextBlock" x:Key="MetricValue">
            <Setter Property="FontSize" Value="23"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
        </Style>
        <Style TargetType="Border" x:Key="MetricIcon">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="46"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Margin" Value="0,0,13,0"/>
        </Style>
        <Style TargetType="TextBox" BasedOn="{StaticResource AccountingInput}"><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
        <Style TargetType="ComboBox" BasedOn="{StaticResource FilterComboBox}"/>
    </UserControl.Resources>
    <DockPanel Margin="24,19,24,16" Background="{StaticResource Workspace}" Language="hu-HU">
        <StackPanel DockPanel.Dock="Top">
            <DockPanel Margin="0,0,0,18">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Click="OpenCashMovements"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8C7;" Style="{StaticResource Icon}" Margin="0,0,8,0"/><TextBlock Text="Pénzmozgások"/></StackPanel></Button>
                    <Button Click="Export"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE898;" Style="{StaticResource Icon}" Margin="0,0,8,0"/><TextBlock Text="Exportálás"/></StackPanel></Button>
                    <Button Click="Add" Style="{StaticResource PrimaryButton}">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE710;" Style="{StaticResource Icon}" Margin="0,0,8,0"/><TextBlock Text="Új tétel"/></StackPanel>
                    </Button>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="Tételek" FontSize="33" FontWeight="Bold"/>
                    <TextBlock Text="Számlák, bérek és járulékok egy helyen" Foreground="{StaticResource MutedInk}" Margin="0,2,0,0"/>
                </StackPanel>
            </DockPanel>
            <UniformGrid Columns="4" Margin="0,0,0,13">
                <Border Style="{StaticResource Card}" Padding="13" Margin="0,0,9,0">
                    <DockPanel>
                        <Border DockPanel.Dock="Left" Style="{StaticResource MetricIcon}" Background="#E4EFFB"><TextBlock Text="&#xE8C7;" Style="{StaticResource Icon}" HorizontalAlignment="Center" FontSize="21" Foreground="#153F68"/></Border>
                        <StackPanel VerticalAlignment="Center"><TextBlock Text="Fizetendő"/><TextBlock x:Name="PayableLabel" Text="—" Style="{StaticResource MetricValue}"/></StackPanel>
                    </DockPanel>
                </Border>
                <Border Style="{StaticResource Card}" Padding="13" Margin="0,0,9,0">
                    <DockPanel>
                        <Border DockPanel.Dock="Left" Style="{StaticResource MetricIcon}" Background="#FFF1D8"><TextBlock Text="&#xE7BA;" Style="{StaticResource Icon}" HorizontalAlignment="Center" FontSize="21" Foreground="#9A5500"/></Border>
                        <StackPanel VerticalAlignment="Center"><TextBlock Text="Lejárt"/><TextBlock x:Name="OverdueLabel" Text="—" Style="{StaticResource MetricValue}" Foreground="#9A5500"/></StackPanel>
                    </DockPanel>
                </Border>
                <Border Style="{StaticResource Card}" Padding="13" Margin="0,0,9,0">
                    <DockPanel>
                        <Border DockPanel.Dock="Left" Style="{StaticResource MetricIcon}" Background="#E4EFFB"><TextBlock Text="&#xE787;" Style="{StaticResource Icon}" HorizontalAlignment="Center" FontSize="21" Foreground="#153F68"/></Border>
                        <StackPanel VerticalAlignment="Center"><TextBlock Text="7 napon belül"/><TextBlock x:Name="DueSoonLabel" Text="—" Style="{StaticResource MetricValue}"/></StackPanel>
                    </DockPanel>
                </Border>
                <Border Style="{StaticResource Card}" Padding="13">
                    <DockPanel>
                        <Border DockPanel.Dock="Left" Style="{StaticResource MetricIcon}" Background="#E2F3E8"><TextBlock Text="&#xE73E;" Style="{StaticResource Icon}" HorizontalAlignment="Center" FontSize="21" Foreground="#14613B"/></Border>
                        <StackPanel VerticalAlignment="Center"><TextBlock Text="Kifizetve ebben a hónapban" TextTrimming="CharacterEllipsis" ToolTip="Kifizetve ebben a hónapban"/><TextBlock x:Name="MonthlyPaidLabel" Text="—" Style="{StaticResource MetricValue}" Foreground="#14613B"/></StackPanel>
                    </DockPanel>
                </Border>
            </UniformGrid>
            <Border Style="{StaticResource Card}" Padding="11,7,11,8" Margin="0,0,0,6">
                <StackPanel>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Szűrés" ui:AccountingUi.Glyph="&#xE71C;" Click="Filter" VerticalAlignment="Bottom" Margin="8,0,0,8"/>
                        <UniformGrid x:Name="PrimaryFilters" Columns="4"/>
                    </DockPanel>
                    <Expander Header="További szűrők" Foreground="{StaticResource MutedInk}">
                        <UniformGrid x:Name="FilterFields" Columns="5" Margin="0,7,0,0"/>
                    </Expander>
                </StackPanel>
            </Border>
            <Border BorderBrush="{StaticResource Outline}" BorderThickness="0,0,0,1" Margin="0,0,0,12">
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="AllTab" Content="Minden tétel" IsChecked="True" Tag="all" GroupName="ObligationTabs" Click="QuickFilter" Style="{StaticResource ListTab}"/>
                    <RadioButton Content="Számlák" Tag="invoices" GroupName="ObligationTabs" Click="QuickFilter" Style="{StaticResource ListTab}"/>
                    <RadioButton Content="Bérek" Tag="NET_SALARY" GroupName="ObligationTabs" Click="QuickFilter" Style="{StaticResource ListTab}"/>
                    <RadioButton Content="Járulékok" Tag="TAX_OR_CONTRIBUTION" GroupName="ObligationTabs" Click="QuickFilter" Style="{StaticResource ListTab}"/>
                    <RadioButton Content="Lejárt" Tag="overdue" GroupName="ObligationTabs" Click="QuickFilter" Style="{StaticResource ListTab}"/>
                </StackPanel>
            </Border>
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <Border Style="{StaticResource Card}" Background="#E8EEF7" Padding="9" Margin="0,0,0,9">
                <DockPanel>
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                        <Button x:Name="Previous" Content="Előző" ui:AccountingUi.Glyph="&#xE76B;" Click="PreviousPage"/>
                        <Button x:Name="Next" Content="Következő" ui:AccountingUi.Glyph="&#xE76C;" Click="NextPage"/>
                        <Button Click="Refresh" Margin="0"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE72C;" Style="{StaticResource Icon}" Margin="0,0,7,0"/><TextBlock Text="Frissítés"/></StackPanel></Button>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="SelectionLabel" Text="Jelölj ki egy tételt" FontWeight="SemiBold" Margin="4,0,12,0" VerticalAlignment="Center"/>
                        <Button x:Name="EditButton" Click="Edit"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8E5;" Style="{StaticResource Icon}" Margin="0,0,7,0"/><TextBlock Text="Megnyitás"/></StackPanel></Button>
                        <Button x:Name="SettlementsButton" Click="OpenSettlements"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8C7;" Style="{StaticResource Icon}" Margin="0,0,7,0"/><TextBlock Text="Rendezések"/></StackPanel></Button>
                        <Button x:Name="ArchiveButton" Content="Archiválás" ui:AccountingUi.Glyph="&#xE7B8;" Click="Archive"/>
                    </StackPanel>
                </DockPanel>
            </Border>
            <DockPanel>
                <TextBlock x:Name="CreditLabel" DockPanel.Dock="Right" Foreground="{StaticResource MutedInk}" Margin="10,0,0,0"/>
                <TextBlock x:Name="StatusLabel" TextWrapping="Wrap" Foreground="{StaticResource MutedInk}"/>
            </DockPanel>
        </StackPanel>
        <Border Style="{StaticResource Card}" Padding="2">
            <DataGrid x:Name="Rows" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                      CanUserSortColumns="False" SelectionMode="Single" HeadersVisibility="Column" AlternationCount="2"
                      SelectionChanged="SelectionChanged" MouseDoubleClick="Edit" Background="White"
                      BorderThickness="0" RowHeight="47" GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#E2E8F0" ColumnHeaderStyle="{StaticResource AccountingHeader}"
                      RowStyle="{StaticResource AccountingRow}" CellStyle="{StaticResource AccountingCell}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Saját cég" Binding="{Binding Company}" ElementStyle="{StaticResource TableText}" Width="*" MinWidth="115"/>
                    <DataGridTemplateColumn Header="Partner / bizonylat" Width="2*" MinWidth="175">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel VerticalAlignment="Center" Margin="11,0,8,0">
                                    <TextBlock Text="{Binding Partner}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Partner}"/>
                                    <TextBlock Text="{Binding Number}" Foreground="{StaticResource MutedInk}" FontSize="12" TextTrimming="CharacterEllipsis" ToolTip="{Binding Number}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock"><Style.Triggers>
                                                <DataTrigger Binding="{Binding Number}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                            </Style.Triggers></Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Típus" Binding="{Binding Type}" ElementStyle="{StaticResource TableText}" Width="105"/>
                    <DataGridTextColumn Header="Határidő" Binding="{Binding DueDate, StringFormat=yyyy.MM.dd.}" ElementStyle="{StaticResource TableText}" Width="100"/>
                    <DataGridTextColumn Header="Összeg (Ft)" Binding="{Binding Amount, StringFormat='#,0.##'}" ElementStyle="{StaticResource AmountText}" Width="117"/>
                    <DataGridTextColumn Header="Hátralék (Ft)" Binding="{Binding Balance, StringFormat='#,0.##'}" ElementStyle="{StaticResource AmountText}" Width="117"/>
                    <DataGridTemplateColumn Header="Állapot" Width="170">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border x:Name="Badge" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="9,0,0,0"
                                        CornerRadius="11" Padding="9,3" Background="#DCEEFF" ToolTip="{Binding Status}">
                                    <StackPanel Orientation="Horizontal" TextElement.Foreground="#124678">
                                        <TextBlock x:Name="StateIcon" Style="{StaticResource Icon}" FontSize="12" Text="&#xEA3A;" Margin="0,0,6,0"/>
                                        <TextBlock x:Name="StateText" Text="{Binding Status}" FontSize="12" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Status}" Value="Rendezett">
                                        <Setter TargetName="Badge" Property="Background" Value="#DBF2E0"/>
                                        <Setter TargetName="StateIcon" Property="Text" Value="&#xE73E;"/>
                                        <Setter TargetName="StateIcon" Property="Foreground" Value="#145D35"/>
                                        <Setter TargetName="StateText" Property="Foreground" Value="#145D35"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="Részben rendezett">
                                        <Setter TargetName="Badge" Property="Background" Value="#DBE8FB"/>
                                        <Setter TargetName="StateIcon" Property="FontFamily" Value="Segoe UI Symbol"/>
                                        <Setter TargetName="StateIcon" Property="Text" Value="◔"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsOverdue}" Value="True">
                                        <Setter TargetName="Badge" Property="Background" Value="#FFF0D4"/>
                                        <Setter TargetName="StateIcon" Property="Text" Value="&#xE7BA;"/>
                                        <Setter TargetName="StateIcon" Property="FontFamily" Value="{StaticResource IconFont}"/>
                                        <Setter TargetName="StateIcon" Property="Foreground" Value="#955400"/>
                                        <Setter TargetName="StateText" Property="Foreground" Value="#955400"/>
                                        <Setter TargetName="StateText" Property="Text" Value="Lejárt"/>
                                    </DataTrigger>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsOverdue}" Value="True"/>
                                            <Condition Binding="{Binding Status}" Value="Részben rendezett"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter TargetName="StateText" Property="Text" Value="Lejárt · részben"/>
                                    </MultiDataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Width="41">
                        <DataGridTemplateColumn.Header><TextBlock Text="&#xE723;" Style="{StaticResource Icon}" ToolTip="Csatolmányok"/></DataGridTemplateColumn.Header>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14" Foreground="{StaticResource MutedInk}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="—"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasAttachment}" Value="True">
                                                    <Setter Property="Text" Value="&#xE723;"/>
                                                    <Setter Property="FontFamily" Value="{StaticResource IconFont}"/>
                                                    <Setter Property="ToolTip" Value="Van csatolmány"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </DockPanel>
</UserControl>
